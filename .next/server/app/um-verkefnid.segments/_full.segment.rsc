c:["$","h2",null,{"className":"text-2xl font-semibold text-neutral-900 mt-10 mb-4","children":"Þróunarferli"}]
d:["$","p",null,{"className":"text-neutral-700 leading-relaxed","children":"Þróunin fylgdi skipulagri nálgun, með notkun gervigreindarverkfæra á hverju stigi:"}]
e:["$","h3",null,{"className":"text-xl font-semibold text-neutral-800 mt-6 mb-3","children":"1. Áætlun og arkitektúr"}]
f:["$","p",null,{"className":"text-neutral-700 leading-relaxed","children":"Sérhæfðir erindrekar (agents) greindu kröfur og buðu upp á útgáfur af uppbyggingu sem passar fyrir lausnina."}]
10:["$","h3",null,{"className":"text-xl font-semibold text-neutral-800 mt-6 mb-3","children":"2. Kóðaframkvæmd"}]
11:["$","p",null,{"className":"text-neutral-700 leading-relaxed","children":"Kóði var skrifaður í samvinnu erindreka (agents), sem veitti tillögur í rauntíma, bjó til grunnkóða og hjálpaði við að innleiða flókna eiginleika eins og fjármálareiknivélar, gagnageymslu í vafra og íslenska staðfærslu."}]
12:["$","h3",null,{"className":"text-xl font-semibold text-neutral-800 mt-6 mb-3","children":"3. Endurtekin betrun"}]
13:["$","p",null,{"className":"text-neutral-700 leading-relaxed","children":"Í gegnum þróunina hjálpuðu gervigreindarverkfæri við að endurskipuleggja kóða, hagræða afkastagetu og bæta kóðagæði. Verkfærin fundu hugsanleg vandamál snemma og buðu upp á umbætur byggðar á bestu starfsvenjum."}]
14:["$","h3",null,{"className":"text-xl font-semibold text-neutral-800 mt-6 mb-3","children":"4. Prófun og gæðaeftirlit"}]
15:["$","p",null,{"className":"text-neutral-700 leading-relaxed","children":"Gervigreindaraðstoð var notuð til að búa til POC, bera kennsl á jaðartilvik og tryggja að prófanir séu framkvæmdar. Verkfærin hjálpuðu við að viðhalda prófunargæðum og samhengi fyrir allan kóðagrunninn."}]
16:["$","h3",null,{"className":"text-xl font-semibold text-neutral-800 mt-6 mb-3","children":"5. Persónuvernd og öryggi"}]
17:["$","p",null,{"className":"text-neutral-700 leading-relaxed","children":"Persónuvernd var samþætt í gegnum allt þróunarferlið. Gervigreindarverkfæri hjálpuðu við að innleiða staðbundna gagnageymslu (localStorage) sem tryggir að öll fjárhagsgögn notenda haldist á þeirra eigin tækjum og séu aldrei send á netþjóna."}]
18:["$","h2",null,{"className":"text-2xl font-semibold text-neutral-900 mt-10 mb-4","children":"Útgáfustjórnun og samvinna"}]
19:["$","p",null,{"className":"text-neutral-700 leading-relaxed","children":"Git var notað í gegnum allt þróunarferlið, með gervigreindarverkfærum sem hjálpuðu við að skrifa commit skilaboð, leggja til greinastrategíur (branch policy) og viðhalda hreinni commit sögu. Allar breytingar voru yfirfarnar af forriturum."}]
1a:["$","h2",null,{"className":"text-2xl font-semibold text-neutral-900 mt-10 mb-4","children":"Samfelld samþætting og útfærsla"}]
1b:["$","p",null,{"className":"text-neutral-700 leading-relaxed","children":"Verkefnið notar CI/CD ferla sem voru settar upp með gervigreindaraðstoð. Sjálfvirk prófun, linting og útfærsluferli tryggja kóðagæði. Gervigreindarverkfærin hjálpuðu við að stilla GitHub Actions verkflæði."}]
1c:["$","h2",null,{"className":"text-2xl font-semibold text-neutral-900 mt-10 mb-4","children":"Útfærsla og innviðir"}]
1d:["$","p",null,{"className":"text-neutral-700 leading-relaxed","children":"Þjónustan er útfærð með nútíma skýja innviðum. Gervigreindarverkfæri aðstoðuðu við velja hentuga rekstarleið, byggða á rektrarsniðmátum frá Peritus. Allt útfærsluferlið var sjálfvirkt og skjalfest."}]
1e:["$","h2",null,{"className":"text-2xl font-semibold text-neutral-900 mt-10 mb-4","children":"Kostir hugbúnaðarþróunar með gervigreind"}]
1f:["$","p",null,{"className":"text-neutral-700 leading-relaxed","children":"Þessi nálgun við þróun býður upp á marga kosti:"}]
20:["$","ul",null,{"className":"list-disc pl-6 text-neutral-700 space-y-2","children":[["$","li",null,{"children":[["$","strong",null,{"children":"Hærri kóðagæði:"}]," Samræmt mynstur, bestu starfsvenjur við kóðaskrif og umfangsmikil villumeðhöndlun"]}],["$","li",null,{"children":[["$","strong",null,{"children":"Betri samhengi:"}]," Gervigreindarverkfæri hjálpa við að viðhalda kóðatengingum og arkitektúrmynstrum um allan kóðagrunninn"]}],["$","li",null,{"children":[["$","strong",null,{"children":"Bætt nám:"}]," Forritarar geta lært af gervigreindartillögum og bætt færni sína"]}],["$","li",null,{"children":[["$","strong",null,{"children":"Bætt samvinna:"}]," Gervigreindarverkfæri starfa sem samfelldur þróunaraðili, tiltækur 24/7"]}]]}]
21:["$","h2",null,{"className":"text-2xl font-semibold text-neutral-900 mt-10 mb-4","children":"Niðurstaða"}]
22:["$","p",null,{"className":"text-neutral-700 leading-relaxed","children":"Þessi þjónusta sýnir kraft gervigreindaraðstoðar við hugbúnaðarþróun þegar hún er sameinuð mannlegri sérfræðiþekkingu. Með því að nýta verkfæri eins og Claude Code og Cursor í gegnum allt þróunarferlið—frá áætlun til útfærslu—gátum við byggt trausta, skalanlega lausn á skilvirkan hátt."}]
23:["$","p",null,{"className":"text-neutral-700 leading-relaxed","children":"Gervigreindarverkfærin skiptu ekki út mannlegum forriturum heldur bættu getu þeirra, sem gerði okkur kleift að einbeita sér að því að leysa flókin vandamál á meðan gervigreindin sá um einfaldari verkefni."}]
