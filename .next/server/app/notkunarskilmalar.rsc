b:["$","h2",null,{"className":"text-xl font-semibold text-neutral-900 mt-8 mb-4","children":"3. Nákvæmni upplýsinga"}]
c:["$","p",null,{"className":"text-neutral-700 leading-relaxed","children":"Við reynum að tryggja að allar upplýsingar séu réttar og uppfærðar, en getum ekki ábyrgst nákvæmni allra útreikinga eða upplýsinga. Notendur bera ábyrgð á að staðfesta upplýsingar hjá viðeigandi aðilum."}]
d:["$","h2",null,{"className":"text-xl font-semibold text-neutral-900 mt-8 mb-4","children":"4. Persónuvernd"}]
e:["$","p",null,{"className":"text-neutral-700 leading-relaxed","children":["Öll gögn sem þú slærð inn í reiknivélarnar eru geymdar staðbundið í vafranum þínum. Við söfnum ekki persónuupplýsingum og sendum engin gögn á netþjóna okkar. Sjá ",["$","a",null,{"href":"/personuvernd","className":"text-primary-600 hover:underline","children":"persónuverndarstefnu"}]," okkar fyrir frekari upplýsingar."]}]
f:["$","h2",null,{"className":"text-xl font-semibold text-neutral-900 mt-8 mb-4","children":"5. Takmarkanir á ábyrgð"}]
10:["$","p",null,{"className":"text-neutral-700 leading-relaxed","children":"Peritus slf. ber ekki ábyrgð á neinu tjóni sem kann að hljótast af notkun þessarar vefsíðu eða trausti á upplýsingum sem hér er að finna. Notkun er alfarið á eigin ábyrgð."}]
11:["$","h2",null,{"className":"text-xl font-semibold text-neutral-900 mt-8 mb-4","children":"6. Auglýsingar"}]
12:["$","p",null,{"className":"text-neutral-700 leading-relaxed","children":"Á síðunni kunna að birtast auglýsingaborðar. Þessir borðar eru handvirkt settir inn af okkur og eru ekki hluti af stærra auglýsinganeti. Við notum ekki auglýsinganet eins og Google Ads eða sambærilegar þjónustur."}]
13:["$","p",null,{"className":"text-neutral-700 leading-relaxed","children":"Auglýsingarnar hafa enga rakningu og safna engum upplýsingum um notendur. Við berum ekki ábyrgð á efni eða þjónustu auglýsenda, þó að við reynum að velja auglýsendur sem við teljum gagnlega og áreiðanlega."}]
14:["$","h2",null,{"className":"text-xl font-semibold text-neutral-900 mt-8 mb-4","children":"7. Fréttabréf"}]
15:["$","p",null,{"className":"text-neutral-700 leading-relaxed","children":"Við bjóðum upp á fréttabréf sem inniheldur fræðsluefni um fjárhagslegt frelsi, FIRE-ráð og upplýsingar um nýjar reiknivélar og eiginleika. Með því að skrá þig á fréttabréfið samþykkir þú að fá tölvupósta frá okkur."}]
16:["$","p",null,{"className":"text-neutral-700 leading-relaxed","children":"Þú getur afskráð þig hvenær sem er með því að smella á afskráningartengil neðst í hverju fréttabréfi. Við munum aldrei selja eða deila netfanginu þínu með þriðju aðilum í markaðsskyni."}]
17:["$","h2",null,{"className":"text-xl font-semibold text-neutral-900 mt-8 mb-4","children":"8. Breytingar á skilmálum"}]
18:["$","p",null,{"className":"text-neutral-700 leading-relaxed","children":"Við áskiljum okkur rétt til að breyta þessum skilmálum hvenær sem er. Breytingar taka gildi um leið og þær eru birtar á síðunni."}]
19:["$","h2",null,{"className":"text-xl font-semibold text-neutral-900 mt-8 mb-4","children":"9. Samskipti"}]
1a:["$","p",null,{"className":"text-neutral-700 leading-relaxed","children":["Ef þú hefur spurningar um þessa skilmála, vinsamlegast hafðu samband við okkur á ",["$","a",null,{"href":"mailto:info@peritus.is","className":"text-primary-600 hover:underline","children":"info@peritus.is"}],"."]}]
1b:["$","p",null,{"className":"text-neutral-500 text-sm mt-12","children":["Síðast uppfært: ","30. janúar 2026"]}]
