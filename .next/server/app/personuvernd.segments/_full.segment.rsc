b:["$","li",null,{"children":"Gögnin yfirgefa aldrei tækið þitt"}]
c:["$","li",null,{"children":"Við höfum engan aðgang að upplýsingunum þínum"}]
d:["$","li",null,{"children":"Þú getur eytt gögnunum hvenær sem er með því að hreinsa vafragögn"}]
e:["$","li",null,{"children":"Gögnin eru aðeins aðgengileg á því tæki og vafra þar sem þú slóst þau inn"}]
f:["$","h2",null,{"className":"text-xl font-semibold text-neutral-900 mt-8 mb-4","children":"3. Vefkökur (Cookies)"}]
10:["$","p",null,{"className":"text-neutral-700 leading-relaxed","children":"Við notum aðeins nauðsynlegar vefkökur sem eru nauðsynlegar til að vefsíðan virki rétt. Við notum engar rakningarvefkökur eða auglýsingavefkökur. Allar auglýsingar og borðar á síðunni eru handvirkt settir inn og hafa enga rakningu virka."}]
11:["$","h2",null,{"className":"text-xl font-semibold text-neutral-900 mt-8 mb-4","children":"4. Greiningartól"}]
12:["$","p",null,{"className":"text-neutral-700 leading-relaxed","children":"Við notum Vercel Analytics til að safna almennum upplýsingum um heimsóknir á síðuna, svo sem fjölda heimsókna og hvaða síður eru skoðaðar. Þetta hjálpar okkur að skilja hvernig síðan er notuð og hvar við getum bætt hana."}]
13:["$","p",null,{"className":"text-neutral-700 leading-relaxed","children":["Vercel Analytics safnar ",["$","strong",null,{"children":"ekki"}]," persónuupplýsingum og notar ekki hefðbundnar rakningarvefkökur. Gögnin eru samanlögð og nafnlaus - við sjáum ekki upplýsingar um einstaka notendur eða hegðun þeirra."]}]
14:["$","h2",null,{"className":"text-xl font-semibold text-neutral-900 mt-8 mb-4","children":"5. Auglýsingar"}]
15:["$","p",null,{"className":"text-neutral-700 leading-relaxed","children":"Á síðunni geta birst auglýsingaborðar. Þessar auglýsingar eru:"}]
16:["$","ul",null,{"className":"list-disc pl-6 text-neutral-700 space-y-2","children":[["$","li",null,{"children":"Handvirkt settar inn af okkur - ekki hluti af stærra auglýsinganeti"}],["$","li",null,{"children":"Án rakningar - engin vefköku eða rakningartækni frá auglýsendum"}],["$","li",null,{"children":"Án persónumiðunar - auglýsingarnar eru þær sömu fyrir alla notendur"}],["$","li",null,{"children":"Valdar af okkur - við veljum auglýsendur sem við teljum gagnlega fyrir notendur okkar"}]]}]
17:["$","p",null,{"className":"text-neutral-700 leading-relaxed mt-4","children":"Við notum ekki auglýsinganet eins og Google Ads eða sambærilegar þjónustur sem rekja notendur á milli vefsíðna."}]
18:["$","h2",null,{"className":"text-xl font-semibold text-neutral-900 mt-8 mb-4","children":"6. Fréttabréf"}]
19:["$","p",null,{"className":"text-neutral-700 leading-relaxed","children":"Ef þú skráir þig á fréttabréfið okkar söfnum við netfanginu þínu. Þetta er eina persónuupplýsingin sem við söfnum og hún er notuð eingöngu til að senda þér fréttabréfið."}]
1a:["$","p",null,{"className":"text-neutral-700 leading-relaxed","children":["Við notum ",["$","strong",null,{"children":"Buttondown"}]," til að senda fréttabréfið. Buttondown geymir netfangið þitt á öruggan hátt og uppfyllir alþjóðlegar persónuverndarreglur (GDPR). Þú getur lesið"," ",["$","a",null,{"href":"https://buttondown.com/legal/privacy","target":"_blank","rel":"noopener noreferrer","className":"text-primary-600 hover:underline","children":"persónuverndarstefnu Buttondown"}]," ","fyrir frekari upplýsingar."]}]
1b:["$","p",null,{"className":"text-neutral-700 leading-relaxed","children":"Þú getur afskráð þig af fréttabréfinu hvenær sem er með því að smella á afskráningartengil neðst í hverju fréttabréfi. Við eyðum netfanginu þínu úr listanum um leið og þú afskráir þig."}]
1c:["$","h2",null,{"className":"text-xl font-semibold text-neutral-900 mt-8 mb-4","children":"7. Þriðju aðilar"}]
1d:["$","p",null,{"className":"text-neutral-700 leading-relaxed","children":"Við deilum engum upplýsingum með þriðju aðilum að undanskildu netfangi áskrifenda fréttabréfs sem er geymt hjá Buttondown (sjá kafla 6). Auglýsendur á síðunni fá engar upplýsingar um notendur frá okkur."}]
1e:["$","h2",null,{"className":"text-xl font-semibold text-neutral-900 mt-8 mb-4","children":"8. Öryggi"}]
1f:["$","p",null,{"className":"text-neutral-700 leading-relaxed","children":"Þar sem öll gögn eru geymd staðbundið í vafranum þínum, þá er öryggi þeirra háð öryggi tækisins þíns og vafrans. Við mælum með að nota öruggan vafra og halda tækinu þínu uppfærðu."}]
20:["$","h2",null,{"className":"text-xl font-semibold text-neutral-900 mt-8 mb-4","children":"9. Réttindi þín"}]
21:["$","p",null,{"className":"text-neutral-700 leading-relaxed","children":"Þú hefur fulla stjórn á öllum gögnum í localStorage vafrans þíns. Ef þú ert skráður á fréttabréfið geturðu afskráð þig hvenær sem er og við eyðum þá netfanginu þínu. Þú getur einnig haft samband við okkur til að óska eftir eyðingu netfangsins."}]
22:["$","h2",null,{"className":"text-xl font-semibold text-neutral-900 mt-8 mb-4","children":"10. Breytingar á stefnu"}]
23:["$","p",null,{"className":"text-neutral-700 leading-relaxed","children":"Ef við breytum þessari persónuverndarstefnu munum við uppfæra þessa síðu. Mikilvægar breytingar verða tilkynntar á forsíðu."}]
